<title>Agency Agreement Builder</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
:root {
  --bg: #f7f5f9; --surface: #ffffff; --ink: #231f20; --muted: #5f5a63;
  --line: #e2dce7; --accent: #662d91; --accent-ink: #ffffff; --gold: #fcb65c; --warn: #8f5300; --ok: #662d91;
  --sans: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #1a1620; --surface: #241f2b; --ink: #f2eef5; --muted: #a9a0b3;
    --line: #3b3346; --accent: #b98ce0; --accent-ink: #1a1620; --gold: #fcb65c; --warn: #fcb65c; --ok: #b98ce0;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #1a1620; --surface: #241f2b; --ink: #f2eef5; --muted: #a9a0b3;
  --line: #3b3346; --accent: #b98ce0; --accent-ink: #1a1620; --gold: #fcb65c; --warn: #fcb65c; --ok: #b98ce0;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--sans); }
.wrap { max-width: 760px; margin: 0 auto; padding-block: 28px 140px; padding-inline: 16px; }
header { display: grid; gap: 14px; margin-bottom: 22px; }
.brand { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.logo-chip { background: #ffffff; border-radius: 10px; padding: 8px 12px; display: inline-flex; border-bottom: 3px solid var(--gold); }
.logo-chip img { display: block; height: 44px; width: auto; max-width: 100%; }
.lang { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--muted); }
.lang select { width: auto; padding: 7px 8px; }
header h1 { margin: 0; font-size: 1.6rem; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; color: var(--accent); }
header p { margin: 0; color: var(--muted); }
.stack { display: grid; gap: 16px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; min-width: 0; }
.card h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; font-size: 1rem; font-weight: 600; }
.step { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font: 500 0.8rem var(--mono); flex: none; }
.hint { margin: -6px 0 14px; color: var(--muted); font-size: 0.85rem; }
.grid { display: grid; gap: 12px 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.grid .wide { grid-column: 1 / -1; }
label { display: grid; gap: 5px; font-size: 0.85rem; color: var(--muted); min-width: 0; }
input, select {
  font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--line);
  border-radius: 7px; padding: 9px 10px; width: 100%; min-width: 0;
}
input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
input:disabled { opacity: 0.6; }
.check { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 0.85rem; }
.check input { width: auto; }
.mono { font-family: var(--mono); }
.dep { border: 1px dashed var(--line); border-radius: 8px; padding: 14px; display: grid; gap: 12px; }
.dep-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-weight: 500; }
button { font: inherit; cursor: pointer; border-radius: 7px; padding: 9px 14px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
button:hover { border-color: var(--accent); }
button:disabled { opacity: 0.6; cursor: default; }
button.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }
button.quiet { border-color: transparent; background: transparent; color: var(--muted); padding-inline: 6px; }
.totals { display: grid; gap: 0; margin: 14px 0 0; }
.totals div { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); }
.totals div:last-child { border-bottom: 0; }
.totals dt { color: var(--muted); }
.totals dd { margin: 0; font-family: var(--mono); font-variant-numeric: tabular-nums; }
.totals .strong dt, .totals .strong dd { color: var(--accent); font-weight: 600; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--surface); border-top: 3px solid var(--gold); padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); }
.bar-inner { max-width: 760px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; }
.status { font-size: 0.88rem; color: var(--muted); min-width: 0; flex: 1 1 260px; }
.status.error { color: var(--warn); }
.status.ok { color: var(--ok); }
.actions { display: flex; gap: 8px; flex-wrap: wrap; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <span class="logo-chip"><img alt="First Generation Group" src="data:image/png;base64,"></span>
      <label class="lang"><span data-i18n="lang_label">Language</span>
        <select id="lang">
          <option value="en">English</option>
          <option value="pt">Português</option>
          <option value="es">Español</option>
        </select>
      </label>
    </div>
    <div>
      <h1 data-i18n="title">Agency Agreement Builder</h1>
      <p data-i18n="intro">Choose the agreement type, fill in the case details and generate the Word (.docx) file from the current template. No client data is stored in this browser.</p>
    </div>
  </header>

  <form id="form" class="stack" novalidate>

    <section class="card">
      <h2><span class="step">1</span><span data-i18n="s1">Agreement type</span></h2>
      <div class="grid">
        <label class="wide"><span data-i18n="agreement">Agreement</span>
          <select id="visa">
            <option value="820" data-i18n="opt820">820 Partner, client sponsored by a family member</option>
            <option value="482C" data-i18n="opt482C">482 Skills in Demand, company as primary client</option>
            <option value="482N" data-i18n="opt482N">482 Skills in Demand, nominee as primary client</option>
            <option value="485" data-i18n="opt485">485 Temporary Graduate</option>
            <option value="ART" data-i18n="optART">ART appeal, refused visa (subclass 500)</option>
          </select>
        </label>
      </div>
    </section>

    <section class="card">
      <h2><span class="step">2</span><span data-i18n="s2">Case details</span></h2>
      <div class="grid">
        <label><span id="ref_label">Client reference</span>
          <input id="client_ref" class="mono" autocomplete="off" placeholder="ABCDEF.25.0001">
        </label>
        <label data-v="482C"><span data-i18n="agreement_date">Agreement date</span>
          <input id="agreement_date" type="date">
        </label>
        <label data-v="482N 485 ART"><span data-i18n="last_page">Last page of the agreement</span>
          <input id="last_page" class="mono" inputmode="numeric" data-i18n-ph="last_page_ph" placeholder="e.g. 7">
        </label>
        <label><span data-i18n="pay_method">Payment method</span>
          <select id="payment_method">
            <option value="bank transfer" data-i18n="pay_bank">Bank transfer</option>
            <option value="credit or debit card" data-i18n="pay_card">Credit or debit card (no surcharge)</option>
          </select>
        </label>
        <label><span data-i18n="pay_mode">Professional fee payment</span>
          <select id="pay_mode">
            <option value="inst" data-i18n="mode_inst">Instalments (deposit and balance)</option>
            <option value="lump" data-i18n="mode_lump">Lump sum (single payment)</option>
          </select>
        </label>
      </div>
    </section>

    <section class="card" data-v="820 485 ART 482N">
      <h2><span class="step">3</span><span id="primary_title">Primary client</span></h2>
      <div class="grid">
        <label class="wide"><span data-i18n="full_name">Full name</span>
          <input id="client_name" autocomplete="off" data-i18n-ph="full_name_ph" placeholder="Name as it appears on the passport">
        </label>
        <label><span data-i18n="dob">Date of birth</span>
          <input id="client_dob" type="date">
        </label>
        <label><span data-i18n="email">Email</span>
          <input id="client_email" type="email" autocomplete="off">
        </label>
        <label><span data-i18n="mobile">Mobile</span>
          <input id="client_mobile" inputmode="tel" autocomplete="off">
        </label>
        <label class="wide"><span data-i18n="res_addr">Residential address (one line)</span>
          <input id="client_address" autocomplete="off">
        </label>
      </div>
    </section>

    <section class="card" data-v="820">
      <h2><span class="step">4</span><span data-i18n="family_sponsor">Family sponsor</span></h2>
      <div class="grid">
        <label class="wide"><span data-i18n="full_name">Full name</span>
          <input id="sponsor_name" autocomplete="off">
        </label>
        <label><span data-i18n="dob">Date of birth</span>
          <input id="sponsor_dob" type="date">
        </label>
        <label><span data-i18n="email">Email</span>
          <input id="sponsor_email" type="email" autocomplete="off">
        </label>
        <label><span data-i18n="mobile">Mobile</span>
          <input id="sponsor_mobile" inputmode="tel" autocomplete="off">
        </label>
        <label class="wide"><span data-i18n="res_addr">Residential address (one line)</span>
          <input id="sponsor_address" autocomplete="off">
        </label>
      </div>
    </section>

    <section class="card" data-v="482C 482N">
      <h2><span class="step">4</span><span data-i18n="company">Sponsoring company</span></h2>
      <div class="grid">
        <label class="wide"><span data-i18n="company_name">Company name</span>
          <input id="business_name" autocomplete="off">
        </label>
        <label><span>ABN</span>
          <input id="business_abn" inputmode="numeric" autocomplete="off">
        </label>
        <label data-v="482N"><span data-i18n="company_ref">Company reference</span>
          <input id="business_ref" class="mono" autocomplete="off" placeholder="ABCDEF.25.0003">
        </label>
        <label><span data-i18n="contact_person">Contact person</span>
          <input id="contact_name" autocomplete="off">
        </label>
        <label class="wide"><span data-i18n="bus_addr">Business address (one line)</span>
          <input id="business_address" autocomplete="off">
        </label>
        <label><span data-i18n="email">Email</span>
          <input id="business_email" type="email" autocomplete="off">
        </label>
        <label><span data-i18n="mobile">Mobile</span>
          <input id="business_mobile" inputmode="tel" autocomplete="off">
        </label>
      </div>
    </section>

    <section class="card" data-v="482C">
      <h2><span class="step">5</span><span data-i18n="signatory">Company signatory</span></h2>
      <div class="grid">
        <label><span data-i18n="signatory_name">Signatory name</span>
          <input id="signatory_name" autocomplete="off">
        </label>
        <label><span data-i18n="position">Position</span>
          <select id="signatory_role">
            <option value="Director" data-i18n="role_dir">Director</option>
            <option value="Secretary" data-i18n="role_sec">Secretary</option>
            <option value="Authorised Representative" data-i18n="role_rep">Authorised representative</option>
          </select>
        </label>
      </div>
    </section>

    <section class="card" data-v="482C">
      <h2><span class="step">6</span><span data-i18n="nominee">Nominee</span></h2>
      <div class="grid">
        <label class="wide"><span data-i18n="full_name">Full name</span>
          <input id="nominee_name" autocomplete="off">
        </label>
        <label><span data-i18n="dob">Date of birth</span>
          <input id="nominee_dob" type="date">
        </label>
        <label><span data-i18n="nominee_ref">Nominee reference</span>
          <input id="nominee_ref" class="mono" autocomplete="off" placeholder="ABCDEF.25.0002">
        </label>
      </div>
    </section>

    <section class="card" data-v="820 482N ART">
      <h2><span class="step">5</span><span data-i18n="deps_title">Dependants and family members (Schedule A)</span></h2>
      <p class="hint" data-i18n="deps_hint">Each person appears in Schedule A or the dependants table. Leave empty if there are none.</p>
      <div id="deps" class="stack"></div>
      <div style="margin-top:12px">
        <button type="button" id="add-dep" data-i18n="add_person">Add person</button>
      </div>
    </section>

    <section class="card" data-v="820 485">
      <h2><span class="step">6</span><span data-i18n="doha">DOHA charges</span></h2>
      <div class="grid">
        <label><span data-i18n="doha_charge">DOHA charge per applicant (AUD)</span>
          <input id="doha_charge" class="mono" inputmode="decimal">
        </label>
        <label><span data-i18n="doha_count">Number of applicants charged</span>
          <input id="doha_count" class="mono" inputmode="numeric" value="1">
        </label>
        <label data-v="820 485" class="wide"><span data-i18n="addl_fee">Fee per additional applicant aged 16 or over (excl. GST)</span>
          <input id="addl_fee" class="mono" inputmode="decimal" data-i18n-ph="use_zero" placeholder="Use 0 if none">
        </label>
      </div>
    </section>

    <section class="card" data-v="482C">
      <h2><span class="step">7</span><span data-i18n="doha482">DOHA charges and levy (482)</span></h2>
      <div class="grid">
        <label><span data-i18n="sp_charge">Sponsorship application charge (AUD)</span>
          <input id="sp_charge" class="mono" inputmode="decimal" value="420.00">
        </label>
        <label><span data-i18n="sp_count">Number of sponsorships</span>
          <input id="sp_count" class="mono" inputmode="numeric" value="1">
        </label>
        <label><span data-i18n="nm_charge">Nomination application charge (AUD)</span>
          <input id="nm_charge" class="mono" inputmode="decimal" value="330.00">
        </label>
        <label><span data-i18n="nm_count">Number of nominations</span>
          <input id="nm_count" class="mono" inputmode="numeric" value="1">
        </label>
        <label><span data-i18n="saf_rate">SAF levy per year (AUD)</span>
          <input id="saf_rate" class="mono" inputmode="decimal" value="1200.00">
        </label>
        <label><span data-i18n="saf_years">Years of visa</span>
          <input id="saf_years" class="mono" inputmode="numeric" value="3">
        </label>
      </div>
    </section>

    <section class="card" data-v="482N">
      <h2><span class="step">7</span><span data-i18n="doha482n">DOHA charges (482 with nominee as primary client)</span></h2>
      <p class="hint" data-i18n="doha482n_hint">Enter the amount and quantity for each line. Card surcharges do not apply.</p>
      <div class="grid">
        <label><span data-i18n="l_main_c">Main applicant visa, amount (AUD)</span>
          <input id="ch_main" class="mono" inputmode="decimal" value="4015.00">
        </label>
        <label><span data-i18n="l_main_n">Main applicant visa, quantity</span>
          <input id="n_main" class="mono" inputmode="numeric" value="1">
        </label>
        <label><span data-i18n="l_sub_c">Subsequent temporary visa, amount (AUD)</span>
          <input id="ch_sub" class="mono" inputmode="decimal" value="700.00">
        </label>
        <label><span data-i18n="l_sub_n">Subsequent temporary visa, quantity</span>
          <input id="n_sub" class="mono" inputmode="numeric" value="1">
        </label>
        <label><span data-i18n="l_a18_c">Additional applicant 18 or over, amount (AUD)</span>
          <input id="ch_a18" class="mono" inputmode="decimal" value="4015.00">
        </label>
        <label><span data-i18n="l_a18_n">Additional applicant 18 or over, quantity</span>
          <input id="n_a18" class="mono" inputmode="numeric" value="1">
        </label>
        <label><span data-i18n="l_u18_c">Additional applicant under 18, amount (AUD)</span>
          <input id="ch_u18" class="mono" inputmode="decimal" value="1005.00">
        </label>
        <label><span data-i18n="l_u18_n">Additional applicant under 18, quantity</span>
          <input id="n_u18" class="mono" inputmode="numeric" value="1">
        </label>
      </div>
    </section>

    <section class="card" data-v="ART">
      <h2><span class="step">6</span><span data-i18n="art_title">ART fee</span></h2>
      <div class="grid">
        <label class="wide"><span data-i18n="art_label">ART review fee, Migration Jurisdictional Area (AUD)</span>
          <input id="art_fee" class="mono" inputmode="decimal">
        </label>
      </div>
      <p class="hint" style="margin-top:12px" data-i18n="art_hint">Source: Migration and Protection Fees, Migration decision review (Part 5 of the Migration Act 1958): $3,727.00.</p>
    </section>

    <section class="card">
      <h2><span class="step" id="fee-step">7</span><span data-i18n="fees">Fees and amounts</span></h2>
      <div class="grid">
        <label class="wide" data-v="820 482C 482N 485"><span data-i18n="prof_fee">Professional fee (excl. GST)</span>
          <input id="fee_professional" class="mono" inputmode="decimal">
        </label>
        <label data-v="ART"><span data-i18n="art_prep">ART application preparation and lodgement (excl. GST)</span>
          <input id="fee_a" class="mono" inputmode="decimal">
        </label>
        <label data-v="ART"><span data-i18n="art_evidence">Evidence collection and written submissions (excl. GST)</span>
          <input id="fee_b" class="mono" inputmode="decimal" value="0">
        </label>
      </div>
      <p class="hint" style="margin-top:14px" data-i18n="gst_hint">GST of 10 per cent applies to the professional fee. The amounts below are calculated automatically. There is no card surcharge.</p>
      <dl class="totals" id="totals"></dl>
    </section>

  </form>
</div>

<div class="bar">
  <div class="bar-inner">
    <div id="status" class="status" role="status" aria-live="polite">Ready to generate.</div>
    <div class="actions">
      <button type="button" id="clear" data-i18n="clear">Clear client data</button>
      <button type="button" id="generate" class="primary" data-i18n="generate">Generate agreement (.docx)</button>
    </div>
  </div>
</div>

<script>var TEMPLATES = { "820": "", "482C": "", "482N": "", "485": "", "ART": "" };</script>
