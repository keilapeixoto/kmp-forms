    if (v === "ART") {
      prof = toCents(val("fee_a")) + toCents(val("fee_b"));
      out.art = toCents(val("art_fee"));
      out.art_gst = Math.round(out.art * 0.10);
      out.art_total = out.art + out.art_gst;
      other = out.art_total;
    } else {
      prof = toCents(val("fee_professional"));
    }
    var gst = Math.round(prof * 0.10);
    var total = prof + gst;
    out.prof = prof; out.gst = gst; out.total = total;
    if (val("pay_mode") === "lump") { out.deposit = total; out.balance = null; }
    else { out.deposit = Math.round(total / 2); out.balance = total - out.deposit; }

    if (v === "820" || v === "485") {
      out.doha = toCents(val("doha_charge")) * Math.max(1, count("doha_count"));
      other = out.doha;
    } else if (v === "482C") {
