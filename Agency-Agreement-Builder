      deposit: money(c.deposit), balance: c.balance === null ? "N/A" : money(c.balance),
      grand_total: money(c.grand),
      secondary: readDeps()
    };
    var pay = { pay1: common.deposit, pay2: common.balance };

    if (v === "820") {
      return Object.assign(common, {
        subclass: "820 Partner",
        client_name: val("client_name"), client_dob: primaryDob(),
        client_email: val("client_email"), client_mobile: val("client_mobile"), client_address: val("client_address"),
        sponsor_name: val("sponsor_name"), sponsor_dob: dmy(val("sponsor_dob")),
        sponsor_email: val("sponsor_email"), sponsor_mobile: val("sponsor_mobile"), sponsor_address: val("sponsor_address"),
        addl_fee: plain(toCents(val("addl_fee"))),
        doha_charge: plain(toCents(val("doha_charge"))), doha_count: String(Math.max(1, count("doha_count"))),
        doha_surcharge_pct: "0.00", doha_surcharge: "$0.00", doha_total: money(c.doha)
      });
    }
    if (v === "485") {
      return Object.assign(common, {
        subclass: "485 Temporary Graduate",
        client_name: val("client_name"), client_dob: primaryDob(),
        client_email: val("client_email"), client_mobile: val("client_mobile"), client_address: val("client_address"),
        addl_fee: plain(toCents(val("addl_fee"))), last_page: val("last_page"),
        doha_charge: money(toCents(val("doha_charge"))), doha_surcharge: "$0.00",
        doha_count: String(Math.max(1, count("doha_count"))), doha_main_total: money(c.doha),
        doha_surcharge_pct: "0.00", doha_total: money(c.doha)
      });
    }
    if (v === "ART") {
      return Object.assign(common, pay, {
        client_name: val("client_name"), client_dob: primaryDob(),
        client_email: val("client_email"), client_mobile: val("client_mobile"), client_address: val("client_address"),
        fee_a: money(toCents(val("fee_a"))), fee_b: money(toCents(val("fee_b"))),
        art_fee: money(c.art_total), last_page: val("last_page")
      });
    }
    if (v === "482N") {
      var out = Object.assign(common, {
        client_name: val("client_name"), client_dob: primaryDob(),
        client_email: val("client_email"), client_mobile: val("client_mobile"), client_address: val("client_address"),
        business_ref: val("business_ref"), business_name: val("business_name"), business_abn: val("business_abn"),
        contact_name: val("contact_name"), business_address: val("business_address"),
        business_email: val("business_email"), business_mobile: val("business_mobile"),
        doha_total: money(c.doha), last_page: val("last_page")
      });
      c.rowsN.forEach(function (r) {
        out["ch_" + r.k] = money(r.charge);
        out["n_" + r.k] = String(r.n);
        out["t_" + r.k] = money(r.total);
      });
      return out;
    }
    // 482C
    return Object.assign(common, {
      agreement_date: longDate(val("agreement_date")),
      business_name: val("business_name"), business_abn: val("business_abn"),
      contact_name: val("contact_name"), business_address: val("business_address"),
      business_email: val("business_email"), business_mobile: val("business_mobile"),
      signatory_name: val("signatory_name"), signatory_role: val("signatory_role"),
      nominee_name: val("nominee_name"), nominee_dob: dmy(val("nominee_dob")), nominee_ref: val("nominee_ref"),
      sp_charge: money(toCents(val("sp_charge"))), sp_surcharge: "$0.00",
      sp_count: String(count("sp_count")), sp_total: money(c.sp),
      nm_charge: money(toCents(val("nm_charge"))), nm_surcharge: "$0.00",
      nm_count: String(count("nm_count")), nm_total: money(c.nm),
      saf_rate: money(toCents(val("saf_rate"))), saf_surcharge: "$0.00",
      saf_years: String(count("saf_years")), saf_total: money(c.saf),
      doha_surcharge_pct: "0.00", doha_total: money(c.doha)
    });
  }

  function missing() {
    var list = [];
    var v = visa();
    var need = function (id, key) { if (!val(id)) list.push(t(key)); };
    need("client_ref", v === "482C" ? "miss_ref_company" : v === "482N" ? "miss_ref_nominee" : "miss_ref_client");
    if (v === "ART") {
      if (toCents(val("fee_a")) <= 0) list.push(t("miss_art_prep"));
      if (toCents(val("art_fee")) <= 0) list.push(t("miss_art"));
    } else if (toCents(val("fee_professional")) <= 0) list.push(t("miss_prof"));
    if (v === "820") {
      need("client_name", "miss_client");
      need("client_dob", "miss_client_dob");
      need("sponsor_name", "miss_sponsor");
      if (!val("addl_fee")) list.push(t("miss_addl"));
    } else if (v === "485" || v === "482N" || v === "ART") {
      need("client_name", v === "482N" ? "miss_nominee" : "miss_client");
      need("client_dob", "miss_dob");
      need("last_page", "miss_last");
    }
    if (v === "482N") need("business_name", "miss_company");
    if (v === "482C") {
      need("agreement_date", "miss_date");
      need("business_name", "miss_company");
      need("business_abn", "miss_abn");
      need("contact_name", "miss_contact");
      need("signatory_name", "miss_signatory");
      need("nominee_name", "miss_nominee");
      need("nominee_dob", "miss_nominee_dob");
      need("nominee_ref", "miss_nominee_ref");
    }
    return list;
  }

  function base64ToBuffer(b64) {
    var bin = atob(b64);
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  }
  function safePart(s) {
    return String(s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^A-Za-z0-9.]+/g, "_").replace(/^_+|_+$/g, "");
  }
  function getDocxLibs() {
    var Docx = window.docxtemplater || window.Docxtemplater;
    var Zip = window.PizZip;
    if (!Docx || !Zip) throw new Error("libs");
    return { Docx: Docx, Zip: Zip };
  }

  async function generate() {
    var list = missing();
    if (list.length) { setStatus(t("miss_prefix") + list.join(", ") + ".", "error"); return; }
    var btn = $("generate");
    btn.disabled = true;
    setStatus(t("building"));
    try {
      var v = visa();
      var libs = getDocxLibs();
      var zip = new libs.Zip(base64ToBuffer(TEMPLATES[v]));
      var doc = new libs.Docx(zip, { paragraphLoop: true, linebreaks: true, nullGetter: function () { return ""; } });
      var data = collect();
      doc.render(data);
      var out = doc.getZip().generate({ type: "arraybuffer", compression: "DEFLATE" });
      var name = "Agreement_" + v + "_" + safePart(data.client_ref || "case") + ".docx";

      if (window.claude) {
        var downloads = window.claude.use ? await window.claude.use("downloads") : null;
        if (!downloads) { setStatus(t("save_fail"), "error"); return; }
        await downloads.save({ filename: name, data: out });
      } else {
        // normal website (e.g. Vercel): standard browser download
        var blob = new Blob([out], { type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document" });
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url; a.download = name;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      }
      setStatus(t("saved") + name + ".", "ok");
    } catch (err) {
      var code = err && err.code;
      if (code === "declined") setStatus(t("cancelled"), "error");
      else if (code === "rate_limited") setStatus(t("rate"), "error");
      else if (err && err.properties && err.properties.errors) setStatus(t("field_err"), "error");
      else if (err && err.message === "libs") setStatus(t("libs"), "error");
      else setStatus(t("fail"), "error");
    } finally {
      btn.disabled = false;
    }
  }

  function clearClient() {
    ["client_name", "client_dob", "client_email", "client_mobile", "client_address",
     "sponsor_name", "sponsor_dob", "sponsor_email", "sponsor_mobile", "sponsor_address",
     "business_name", "business_abn", "business_ref", "contact_name", "business_address", "business_email", "business_mobile",
     "signatory_name", "nominee_name", "nominee_dob", "nominee_ref", "client_ref", "agreement_date", "last_page", "art_fee"].forEach(function (id) { $(id).value = ""; });
    document.querySelectorAll(".dep").forEach(function (c) { c.remove(); });
    renderTotals();
    setStatus(t("cleared"));
  }

  /* ---------- wire up ---------- */
  $("lang").addEventListener("change", function () {
    lang = $("lang").value;
    try { localStorage.setItem("agr_lang", lang); } catch (e) {}
    applyLang();
    setStatus(t("ready"));
  });
  $("visa").addEventListener("change", showVisa);
  $("add-dep").addEventListener("click", function () { $("deps").appendChild(depCard()); renumber(); });
  $("form").addEventListener("input", function (e) {
    if (e.target && e.target.id) touched[e.target.id] = true;
    renderTotals();
  });
  $("form").addEventListener("change", renderTotals);
  $("clear").addEventListener("click", clearClient);
  $("generate").addEventListener("click", generate);
  $("form").addEventListener("submit", function (e) { e.preventDefault(); generate(); });
  pickLang();
  applyLang();
  setStatus(t("ready"));
})();
</script>
